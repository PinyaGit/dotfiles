class CheatsheetWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="Шпаргалка Hyprland, Caelestia и Игры")
        self.set_default_size(860, 640)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.connect("key-press-event", self.on_key_press)
        self.connect("destroy", Gtk.main_quit)

        self.clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)

        # Main Layout
        main_vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        main_vbox.set_margin_top(12)
        main_vbox.set_margin_bottom(12)
        main_vbox.set_margin_start(16)
        main_vbox.set_margin_end(16)
        self.add(main_vbox)

        # Header with StackSwitcher & Search
        top_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        main_vbox.pack_start(top_bar, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(180)

        switcher = Gtk.StackSwitcher()
        switcher.set_stack(self.stack)
        top_bar.pack_start(switcher, True, True, 0)

        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Поиск... (Ctrl+F)")
        self.search_entry.set_width_chars(20)
        self.search_entry.connect("search-changed", self.on_search_changed)
        top_bar.pack_end(self.search_entry, False, False, 0)

        # Notification toast
        self.toast_label = Gtk.Label(label="")
        self.toast_label.get_style_context().add_class("subtext")
        self.toast_label.set_no_show_all(True)
        main_vbox.pack_start(self.toast_label, False, False, 0)

        # Populate Tabs
        self.all_rows = []
        for tab_name, content in DATA.items():
            scroll = Gtk.ScrolledWindow()
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            box.set_margin_top(8)
            box.set_margin_bottom(8)
            box.set_margin_start(4)
            box.set_margin_end(4)

            # Flags section if any
            if "flags" in content:
                lbl = Gtk.Label(label="ПАРАМЕТРЫ ЗАПУСКА STEAM (КЛИК ДЛЯ КОПИРОВАНИЯ)", xalign=0)
                lbl.get_style_context().add_class("section-title")
                box.pack_start(lbl, False, False, 0)

                for flag, desc in content["flags"]:
                    row = self.create_flag_row(flag, desc)
                    box.pack_start(row, False, False, 0)
                    self.all_rows.append((row, (flag + " " + desc).lower()))

            # Keys section
            if "keys" in content:
                lbl = Gtk.Label(label="ГОРЯЧИЕ КЛАВИШИ", xalign=0)
                lbl.get_style_context().add_class("section-title")
                box.pack_start(lbl, False, False, 0)

                for keys, desc in content["keys"]:
                    row = self.create_key_row(keys, desc)
                    box.pack_start(row, False, False, 0)
                    self.all_rows.append((row, (keys + " " + desc).lower()))

            scroll.add(box)
            self.stack.add_titled(scroll, tab_name, tab_name)

        main_vbox.pack_start(self.stack, True, True, 0)

        # Footer
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        footer.set_margin_top(4)
        hint = Gtk.Label(label="Нажмите Esc для закрытия | Кликните «Копировать» для параметров запуска Steam", xalign=0)
        hint.get_style_context().add_class("subtext")
        footer.pack_start(hint, True, True, 0)

        close_btn = Gtk.Button(label="Закрыть (Esc)")
        close_btn.get_style_context().add_class("copy-btn")
        close_btn.connect("clicked", lambda _: Gtk.main_quit())
        footer.pack_end(close_btn, False, False, 0)

        main_vbox.pack_end(footer, False, False, 0)

    def create_flag_row(self, flag: str, desc: str):
        row = Gtk.ListBoxRow()
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        box.set_margin_top(4)
        box.set_margin_bottom(4)

        flag_lbl = Gtk.Label(label=flag, xalign=0)
        flag_lbl.get_style_context().add_class("flag-badge")
        flag_lbl.set_selectable(True)
        box.pack_start(flag_lbl, False, False, 0)

        desc_lbl = Gtk.Label(label=desc, xalign=0)
        desc_lbl.set_line_wrap(True)
        box.pack_start(desc_lbl, True, True, 0)

        btn = Gtk.Button(label="📋 Скопировать")
        btn.get_style_context().add_class("copy-btn")
        btn.connect("clicked", lambda _, f=flag, b=btn: self.copy_to_clip(f, b))
        box.pack_end(btn, False, False, 0)

        row.add(box)
        return row

    def create_key_row(self, keys: str, desc: str):
        row = Gtk.ListBoxRow()
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        box.set_margin_top(4)
        box.set_margin_bottom(4)

        keys_lbl = Gtk.Label(label=keys, xalign=0)
        keys_lbl.get_style_context().add_class("key-badge")
        keys_lbl.set_size_request(240, -1)
        box.pack_start(keys_lbl, False, False, 0)

        desc_lbl = Gtk.Label(label=desc, xalign=0)
        desc_lbl.set_line_wrap(True)
        box.pack_start(desc_lbl, True, True, 0)

        row.add(box)
        return row

    def copy_to_clip(self, text: str, btn: Gtk.Button):
        self.clipboard.set_text(text, -1)
        orig_text = btn.get_label()
        btn.set_label("✓ Скопировано!")
        GLib.timeout_add(1500, lambda: btn.set_label(orig_text))

    def on_search_changed(self, entry):
        query = entry.get_text().strip().lower()
        for row, text in self.all_rows:
            if not query or query in text:
                row.set_visible(True)
            else:
                row.set_visible(False)

    def on_key_press(self, widget, event):
        if event.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()
            return True
        if (event.state & Gdk.ModifierType.CONTROL_MASK) and event.keyval in (Gdk.KEY_f, Gdk.KEY_F):
            self.search_entry.grab_focus()
            return True
        return False


def main():
    GLib.set_prgname("hypr-cheatsheet")
    GLib.set_application_name("Шпаргалка")

    css_provider = Gtk.CssProvider()
    css_provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(),
        css_provider,
        Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
    )

    win = CheatsheetWindow()
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
