+namespace {
+
+struct I18nLoader {
+    QTranslator* translator = nullptr;
+    I18nLoader() {
+        QLocale loc;
+        if (loc.language() == QLocale::Russian || loc.name().startsWith(QLatin1String("ru"))) {
+            translator = new QTranslator(QCoreApplication::instance());
+            const QString path = QDir::homePath() + QStringLiteral("/.config/quickshell/op-caelestia/translations/caelestia_ru.qm");
+            if (translator->load(path)) {
+                QCoreApplication::installTranslator(translator);
+                qCInfo(lcCUtils) << "Installed Russian translation from" << path;
+            } else {
+                qCWarning(lcCUtils) << "Failed to load translation from" << path;
+            }
+        }
+    }
+};
+
+static I18nLoader s_i18nLoader;
+
+} // namespace
+
